# 360VUE HQ — copy to .env.local for development. Never commit real values.
# Generate the secret and the logins with:  node scripts/make-hq-env.mjs --local

HQ_SESSION_SECRET=
# JSON list of logins with sha256 password hashes (written by the script)
HQ_USERS=

# The PRIVATE data repository. Leave all three empty in development to use the local data/ folders.
# Never a FrameMind or JOVE repository: 360VUE HQ refuses to read or write one.
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_TOKEN=

# Where the site and HQ are deployed (canonical links, sitemap, links in papers to sign). Default in production: https://360vue.website
NEXT_PUBLIC_SITE_URL=
# The public website, if it is ever served from another address (defaults to NEXT_PUBLIC_SITE_URL)
NEXT_PUBLIC_WEBSITE_URL=

# Optional — shown on the website and printed on papers when set (nothing is shown when empty)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_LOCATION=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_YOUTUBE=
NEXT_PUBLIC_LINKEDIN=

# Optional — the morning digest email (Vercel cron: /api/cron/digest)
RESEND_API_KEY=
DIGEST_FROM=
CRON_SECRET=

# Optional — set to 1 to make HQ read-only
VUE_READONLY=
